# ═══════════════════════════════════════════════════════════════
# THE OUTSIDERS — Late Drift Sniper v3 Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Polymarket CLOB (required for --live mode) ─────────────
# Your Polygon wallet private key (hex, with or without 0x prefix)
# This wallet must have USDC deposited on Polymarket
POLYGON_PRIVATE_KEY=

# Your Polygon wallet address (0x...)
# Must match the private key above
POLYGON_WALLET_ADDRESS=

# ─── Optional: Override API endpoints ────────────────────────
# Only change these if you're using a custom proxy or testnet
# GAMMA_API_URL=https://gamma-api.polymarket.com
# CLOB_API_URL=https://clob.polymarket.com

# ─── Optional: PolyBackTest.com API (premium backtest data) ──
# Sub-second orderbook snapshots + Chainlink reference prices
# Sign up at https://polybacktest.com for an API key
# POLYBACKTEST_API_KEY=

# ─── Optional: Telegram notifications ───────────────────────
# Get a bot token from @BotFather, chat_id from @userinfobot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
